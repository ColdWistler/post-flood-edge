# Copy to .env and fill in the tokens only when using --mqtt.
# Never commit the real .env file.
TB_HOST=
TB_CA_CERT=
TB_TOKEN_NODE_A=
TB_TOKEN_NODE_B=
TB_TOKEN_NODE_C=

# Edge defaults (demo values shown as placeholders).
EDGE_BATCH_SIZE=50
EDGE_BUFFER_MAX_ROWS=6048
EDGE_FLOW_ZERO_SUSTAINED_S=30.0
EDGE_NODE_INACTIVE_S=90.0
EDGE_DERIVATIVE_WINDOW_S=50.0
EDGE_VALIDITY_FAULT_SAMPLES=3
EDGE_TICK_SECONDS=5.0
EDGE_DB_PATH=edge.db
EDGE_LOG_LEVEL=INFO
