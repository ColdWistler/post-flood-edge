{
  "name": "Rapid Turbidity Rise",
  "type": "ALARM",
  "configuration": {
    "type": "ALARM",
    "arguments": {
      "active_alarms": {
        "refEntityKey": {
          "key": "active_alarms",
          "type": "TS_LATEST"
        }
      }
    },
    "createRules": {
      "WARNING": {
        "condition": {
          "type": "SIMPLE",
          "expression": {
            "type": "SIMPLE",
            "filters": [
              {
                "argument": "active_alarms",
                "valueType": "STRING",
                "operation": "AND",
                "predicates": [
                  {
                    "type": "STRING",
                    "operation": "CONTAINS",
                    "value": {
                      "staticValue": "Rapid Turbidity Rise"
                    },
                    "ignoreCase": false
                  }
                ]
              }
            ],
            "operation": "AND"
          },
          "schedule": {
            "staticValue": {
              "type": "ANY_TIME"
            }
          }
        },
        "alarmDetails": ""
      }
    },
    "clearRule": {
      "condition": {
        "type": "SIMPLE",
        "expression": {
          "type": "SIMPLE",
          "filters": [
            {
              "argument": "active_alarms",
              "valueType": "STRING",
              "operation": "AND",
              "predicates": [
                {
                  "type": "STRING",
                  "operation": "NOT_CONTAINS",
                  "value": {
                    "staticValue": "Rapid Turbidity Rise"
                  },
                  "ignoreCase": false
                }
              ]
            }
          ],
          "operation": "AND"
        },
        "schedule": {
          "staticValue": {
            "type": "ANY_TIME"
          }
        }
      },
      "alarmDetails": ""
    },
    "propagate": false,
    "propagateToOwner": false,
    "propagateToOwnerHierarchy": false,
    "propagateToTenant": false,
    "propagateRelationTypes": []
  },
  "additionalInfo": {
    "description": "Mirrors the edge-derived rapid-rise alarm via active_alarms CONTAINS."
  }
}
